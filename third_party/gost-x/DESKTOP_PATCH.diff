+// stripDesktopHopHeaders removes connection-scoped fields on each proxy hop.
+// Request/Response framing is retained in net/http's structured fields; the
+// transport/writer generates the correct outgoing framing. Upgrade remains
+// available to GOST's existing WebSocket handling.
+func stripDesktopHopHeaders(header http.Header, allowUpgrade bool) {
+	upgrade := ""
+	trailers := false
+	for _, value := range header.Values("Te") {
+		for _, token := range strings.Split(value, ",") {
+			if strings.EqualFold(strings.TrimSpace(token), "trailers") {
+				trailers = true
+			}
+		}
+	}
+	for _, value := range header.Values("Connection") {
+		for _, token := range strings.Split(value, ",") {
+			token = strings.TrimSpace(token)
+			if allowUpgrade && strings.EqualFold(token, "upgrade") {
+				upgrade = header.Get("Upgrade")
+			}
+		}
+	}
+	for _, value := range header.Values("Connection") {
+		for _, token := range strings.Split(value, ",") {
+			if token = strings.TrimSpace(token); token != "" {
+				header.Del(token)
+			}
+		}
+	}
+	for _, name := range []string{"Connection", "Proxy-Connection", "Keep-Alive", "Proxy-Authenticate", "Proxy-Authorization", "Te", "Trailer", "Transfer-Encoding", "Upgrade"} {
+		header.Del(name)
+	}
+	if trailers {
+		header.Set("Te", "trailers")
+	}
+	if upgrade != "" {
+		header.Set("Connection", "Upgrade")
+		header.Set("Upgrade", upgrade)
+	}
+}
